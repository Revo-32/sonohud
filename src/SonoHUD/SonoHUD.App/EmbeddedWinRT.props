<Project>
  <PropertyGroup>
    <!-- Generate only from the explicitly MIT/Apache licensed, pinned metadata. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <CsWinRTEmbedded>true</CsWinRTEmbedded>
    <CsWinRTWindowsMetadata>&quot;$(MSBuildProjectDirectory)/../../../third_party/windows-metadata/Windows.winmd&quot;</CsWinRTWindowsMetadata>
    <CsWinRTIncludes>
      Windows.Foundation;
      Windows.Media.Control;
      Windows.Media.MediaPlaybackType;
      Windows.Media.MediaPlaybackAutoRepeatMode;
      Windows.System.DispatcherQueue;
      Windows.System.IDispatcherQueue;
      Windows.UI.Composition;
      Windows.Graphics.DirectX;
      Windows.Graphics.Effects;
      Windows.Graphics.PointInt32;
      Windows.Graphics.SizeInt32;
      Windows.Graphics.RectInt32;
      Windows.Graphics.IGeometrySource2D;
      Windows.Storage.Streams.IBuffer;
      Windows.Storage.Streams.IDataReader;
      Windows.Storage.Streams.DataReader;
      Windows.Storage.Streams.IInputStream;
      Windows.Storage.Streams.IOutputStream;
      Windows.Storage.Streams.IRandomAccessStream;
      Windows.Storage.Streams.IContentTypeProvider;
      Windows.Storage.Streams.InputStreamOptions;
      Windows.Storage.Streams.ByteOrder;
      Windows.Storage.Streams.UnicodeEncoding;
      Windows.UI.Core.CoreDispatcher;
      Windows.UI.Core.ICoreDispatcher;
      Windows.UI.Core.CoreProcessEventsOption;
      Windows.UI.Core.DispatchedHandler;
      Windows.UI.Core.IdleDispatchedHandler;
      Windows.UI.Core.IdleDispatchedHandlerArgs;
      Windows.UI.Core.IIdleDispatchedHandlerArgs;
      Windows.Storage.Streams.Buffer;
      Windows.UI.Core.ICoreAcceleratorKeys;
      Windows.UI.Core.AcceleratorKeyEventArgs;
      Windows.UI.Core.IAcceleratorKeyEventArgs;
      Windows.UI.Core.CoreAcceleratorKeyEventType;
      Windows.UI.Core.CorePhysicalKeyStatus;
      Windows.System.VirtualKey;
      Windows.UI.Core.ICoreWindowEventArgs
    </CsWinRTIncludes>
    <CsWinRTExcludes>
      Windows;
      Microsoft;
      Windows.Foundation.PropertyType;
      Windows.UI.Composition.Interactions;
      Windows.UI.Composition.Scenes;
      Windows.UI.Composition.Effects;
      Windows.UI.Composition.Diagnostics;
      Windows.Foundation.Diagnostics;
      Windows.Storage.Streams.IRandomAccessStreamReferenceStatics
    </CsWinRTExcludes>
    <WinRTRuntimeSourcesDir>$(MSBuildProjectDirectory)/../../../third_party/CsWinRT-2.2.0/embedded/</WinRTRuntimeSourcesDir>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
