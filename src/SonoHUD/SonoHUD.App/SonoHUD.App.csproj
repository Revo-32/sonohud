<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="EmbeddedWinRT.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>SonoHUD.App.EntryPoint</StartupObject>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SonoHUD</AssemblyName>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Branding/SonoHUD.ico</ApplicationIcon>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <None Include="../../../LICENSE;../../../NOTICE;../../../THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../../licenses/**/*" Exclude="../../../licenses/Windows-SDK-license.*;../../../licenses/Microsoft.Windows.SDK.NET.Ref-*.nuspec;../../../licenses/M5.1-*;../../../licenses/CsWinRT-MIT.txt;../../../licenses/FluentFlyout-v2.16.1/LICENSE" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../../docs/release/M7.2-core-privacy.md" Link="개인정보와-보안.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SonoHUD.Core/SonoHUD.Core.csproj" />
    <ProjectReference Include="../SonoHUD.PluginContracts/SonoHUD.PluginContracts.csproj" />
    <Resource Include="Assets/Fonts/**/*.otf;Assets/Fonts/**/*.ttf" />
    <Resource Include="Assets/Branding/C-wave-refinement-v2.png;Assets/Branding/SonoHUD.ico;Assets/Branding/branding-manifest.json" />
    <None Update="Assets/Fonts/**/OFL.txt;Assets/Fonts/font-manifest.json;Assets/Fonts/README.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="EmbeddedWinRT.targets" />
</Project>
