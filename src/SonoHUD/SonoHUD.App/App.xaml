<Application x:Class="SonoHUD.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SonoHUD.App.Views" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Base" Color="#11151C" />
    <SolidColorBrush x:Key="Panel" Color="#1B222C" />
    <SolidColorBrush x:Key="Raised" Color="#293341" />
    <SolidColorBrush x:Key="Line" Color="#364353" />
    <SolidColorBrush x:Key="Ink" Color="#F0F3F7" />
    <SolidColorBrush x:Key="Muted" Color="#A7B4C4" />
    <SolidColorBrush x:Key="Accent" Color="#77DDC7" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style TargetType="Window">
      <Setter Property="Icon" Value="pack://application:,,,/SonoHUD;component/Assets/Branding/SonoHUD.ico" />
      <Setter Property="Background" Value="{StaticResource Base}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontFamily" Value="{x:Static views:DesignResources.FontFamily}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,12,0,5" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="27" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource Raised}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.38" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#10231F" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style x:Key="NavHomeStyle" TargetType="Button" BasedOn="{StaticResource Navigation}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding HomeVisible}" Value="True">
          <Setter Property="Background" Value="#31483F" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="AutomationProperties.ItemStatus" Value="현재 페이지" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavScenesStyle" TargetType="Button" BasedOn="{StaticResource Navigation}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ScenesVisible}" Value="True">
          <Setter Property="Background" Value="#31483F" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="AutomationProperties.ItemStatus" Value="현재 페이지" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavEditorStyle" TargetType="Button" BasedOn="{StaticResource Navigation}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding EditorVisible}" Value="True">
          <Setter Property="Background" Value="#31483F" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="AutomationProperties.ItemStatus" Value="현재 페이지" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavSettingsStyle" TargetType="Button" BasedOn="{StaticResource Navigation}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SettingsVisible}" Value="True">
          <Setter Property="Background" Value="#31483F" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="AutomationProperties.ItemStatus" Value="현재 페이지" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#121923" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Foreground" Value="#15202D" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Margin" Value="0,8,12,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="#31483F" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="SceneItem">
      <StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
      </StackPanel>
    </DataTemplate>
  </Application.Resources>
</Application>
