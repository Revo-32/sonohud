<UserControl x:Class="SonoHUD.App.Views.HomePlayerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SonoHUD.App.Views" AutomationProperties.AutomationId="HomePlayerView" FontFamily="{x:Static views:DesignResources.FontFamily}" Foreground="{DynamicResource StudioInk}">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="PlayerVisibility"/></ResourceDictionary></UserControl.Resources>
  <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioLine}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,16" Visibility="{Binding DemoMode, Converter={StaticResource PlayerVisibility}}" AutomationProperties.AutomationId="HomeDemoBanner"><DockPanel><Button DockPanel.Dock="Right" Content="실제 음악으로 돌아가기" Command="{Binding ExitDemoCommand}" AutomationProperties.AutomationId="HomeExitDemo" Margin="24,0,0,0"/><StackPanel><TextBlock Text="자체 샘플을 보고 있습니다" FontWeight="SemiBold"/><TextBlock Text="실제 음악을 재생하거나 제어하지 않습니다." Style="{StaticResource StudioMetadata}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="Transparent" AutomationProperties.AutomationId="HomePlaybackCard">
      <StackPanel>
        <Grid>
        <Border x:Name="PlaybackSurface" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioLine}" BorderThickness="0" CornerRadius="12" Padding="24">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn" Width="360"/><ColumnDefinition x:Name="ArtworkGap" Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="ArtworkFrame" Width="360" Height="360" AutomationProperties.AutomationId="HomeArtwork" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioLine}" BorderThickness="0" CornerRadius="6" VerticalAlignment="Center" ClipToBounds="True"><Grid>
              <views:ArtworkPlaceholder><views:ArtworkPlaceholder.Style><Style TargetType="views:ArtworkPlaceholder"><Style.Triggers><DataTrigger Binding="{Binding HasArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:ArtworkPlaceholder.Style></views:ArtworkPlaceholder>
              <Image Source="{Binding AlbumArt}" Stretch="Uniform" AutomationProperties.Name="현재 음악 앨범아트"/>
              <Border x:Name="CoverLight" IsHitTestVisible="False" Opacity="0" BorderThickness="2" CornerRadius="6" BorderBrush="{DynamicResource PrismRibbon}"/>
            </Grid></Border>
            <Grid Grid.Column="2" Margin="0,4,0,4" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{DynamicResource PrismRefraction}" Grid.RowSpan="3" Margin="22,0,8,0" IsHitTestVisible="False"/>
              <Border Background="Transparent" CornerRadius="4" Padding="0" HorizontalAlignment="Left" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="PlaybackIndicator" Width="7" Height="7" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource StudioTertiary}"/><Style.Triggers><DataTrigger Binding="{Binding PlayGlyph}" Value="Ⅱ"><Setter Property="Fill" Value="{DynamicResource StudioProgress}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding PlayerPlaybackStatus}" FontFamily="{x:Static views:DesignResources.FontFamily}" FontSize="12" AutomationProperties.AutomationId="HomePlaybackStatus"/></StackPanel></Border>
              <StackPanel Grid.Row="1">
                <TextBlock x:Name="HomeTitle" Text="{Binding TrackTitle}" FontFamily="{x:Static views:DesignResources.FontFamily}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="38" MaxHeight="76" VerticalAlignment="Top" ToolTip="{Binding TrackTitle}" AutomationProperties.AutomationId="TrackTitle"/>
                <TextBlock Text="{Binding TrackArtist}" Foreground="{DynamicResource StudioMuted}" FontFamily="{x:Static views:DesignResources.FontFamily}" FontSize="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding TrackArtist}" Margin="0,8,0,0" AutomationProperties.AutomationId="HomeTrackArtist"/>
                <TextBlock Text="{Binding TrackAlbum}" Foreground="{DynamicResource StudioTertiary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding TrackAlbum}" Margin="0,6,0,0" AutomationProperties.AutomationId="HomeTrackAlbum"/>
                <TextBlock Text="{Binding PlayerSource, StringFormat=재생 소스 · {0}}" Style="{StaticResource StudioMicro}" FontSize="11" ToolTip="{Binding PlayerSource}" Margin="0,8,0,0" AutomationProperties.AutomationId="HomePlayerSource"/>
              </StackPanel>
              <StackPanel x:Name="PlaybackButtons" Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Margin="0,24,0,0" VerticalAlignment="Bottom">
                <Button Style="{StaticResource StudioIconButton}" Width="44" Height="44" Background="Transparent" BorderBrush="Transparent" Command="{Binding PreviousCommand}" Margin="0,0,8,0" ToolTip="이전 곡" AutomationProperties.AutomationId="Previous" AutomationProperties.Name="이전 곡"><views:IconGlyph Kind="Previous" Width="20" Height="20"/></Button>
                <Button Style="{StaticResource StudioPlayback}" Command="{Binding PlayCommand}" MinWidth="136" Height="44" Margin="0,0,8,0" AutomationProperties.AutomationId="Play" AutomationProperties.Name="{Binding PlayLabel}"><StackPanel Orientation="Horizontal"><views:IconGlyph Width="18" Height="18" Margin="0,0,12,0"><views:IconGlyph.Style><Style TargetType="views:IconGlyph"><Setter Property="Kind" Value="Play"/><Style.Triggers><DataTrigger Binding="{Binding PlayGlyph}" Value="Ⅱ"><Setter Property="Kind" Value="Pause"/></DataTrigger></Style.Triggers></Style></views:IconGlyph.Style></views:IconGlyph><TextBlock Text="{Binding PlayLabel}" FontWeight="SemiBold"/></StackPanel></Button>
                <Button Style="{StaticResource StudioIconButton}" Width="44" Height="44" Background="Transparent" BorderBrush="Transparent" Command="{Binding NextCommand}" ToolTip="다음 곡" AutomationProperties.AutomationId="Next" AutomationProperties.Name="다음 곡"><views:IconGlyph Kind="Next" Width="20" Height="20"/></Button>
              </StackPanel>
        <Grid Grid.Row="3" Grid.ColumnSpan="2" x:Name="TimelineArea" ToolTip="{Binding SeekHint}" Margin="12,20,12,0" PreviewMouseLeftButtonDown="SeekMouseDown" PreviewMouseLeftButtonUp="SeekMouseUp"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Slider x:Name="SeekSlider" Minimum="{Binding SeekMinimum}" Maximum="{Binding SeekMaximum}" Value="{Binding SeekValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SmallChange="5" LargeChange="15" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" PreviewKeyDown="SeekKeyDown" PreviewKeyUp="SeekKeyUp" LostKeyboardFocus="SeekLostFocus" AutomationProperties.AutomationId="HomeSeekSlider" AutomationProperties.Name="재생 위치 이동"><Slider.Style><Style TargetType="Slider" BasedOn="{StaticResource StudioTimelineSlider}"><Style.Triggers><DataTrigger Binding="{Binding ShowSeekControl}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Slider.Style></Slider>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Foreground="{DynamicResource StudioProgress}" Margin="12,20,12,20" AutomationProperties.AutomationId="HomeReadOnlyProgress" AutomationProperties.Name="재생 진행률, 읽기 전용"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding ShowSeekControl}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
          <Border x:Name="TimelineRuler" Grid.Row="1" Height="4" Margin="12,0" IsHitTestVisible="False"><Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,16,8" ViewportUnits="Absolute" Stretch="None"><DrawingBrush.Drawing><GeometryDrawing Geometry="M0.5,0 L0.5,4"><GeometryDrawing.Pen><Pen Brush="{DynamicResource StudioLine}" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Border.Background></Border>
          <Grid Grid.Row="2" Margin="12,8,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CurrentTime}" Style="{StaticResource StudioTime}" Foreground="{DynamicResource StudioInk}" FontSize="14" AutomationProperties.AutomationId="HomeCurrentTime"/><TextBlock Grid.Column="1" Text="{Binding SeekPreviewTime}" Foreground="{DynamicResource StudioProgress}" FontFamily="{x:Static views:DesignResources.FontFamily}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding TotalTime}" Style="{StaticResource StudioTime}" FontSize="14" HorizontalAlignment="Right" AutomationProperties.AutomationId="HomeTotalTime"/></Grid>
          <Border x:Name="SeekHelpSlot" Grid.Row="3">
            <TextBlock Text="{Binding SeekHint}" FontSize="11" Foreground="{DynamicResource StudioTertiary}" Margin="12,12,12,0">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StudioDescription}">
                <Style.Triggers><DataTrigger Binding="{Binding CanSeek}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </Border>
        </Grid>

            </Grid>
          </Grid>
        </Border>
        <Border Height="2" Margin="14,0" VerticalAlignment="Top" IsHitTestVisible="False" Background="{DynamicResource PrismRibbon}"/>
        </Grid>
        <TextBlock Text="{Binding MediaStatus}" Visibility="{Binding HasMediaStatus, Converter={StaticResource PlayerVisibility}}" Style="{StaticResource StudioDescription}" Foreground="{DynamicResource StudioWarning}" Margin="8,16,8,4" AutomationProperties.AutomationId="HomeMediaStatus"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" Text="{Binding PlayerConnectionHint}" Visibility="{Binding PlayerNeedsConnection, Converter={StaticResource PlayerVisibility}}" Style="{StaticResource StudioDescription}" Margin="8,16,8,0" AutomationProperties.AutomationId="HomeConnectionHint"/>
    <Border Grid.Row="3" x:Name="FrequencyPanel" Margin="12,20,12,0" Visibility="{Binding HomeSpectrumVisible, Converter={StaticResource PlayerVisibility}}" AutomationProperties.AutomationId="HomeSpectrumPanel"><StackPanel>
      <Grid Margin="0,0,0,12"><TextBlock Text="시스템 사운드" Style="{StaticResource StudioMetadata}"/><TextBlock Text="{Binding SpectrumStatus}" HorizontalAlignment="Right" Style="{StaticResource StudioMicro}"/></Grid>
      <views:SpectrumView x:Name="FrequencySpectrum" Height="64" AutomationProperties.AutomationId="HomeSpectrum" AutomationProperties.Name="시스템 출력의 주파수 분포"/>
      <Grid x:Name="FrequencyLabels" Margin="0,10,0,0"><TextBlock Text="저음" Style="{StaticResource StudioMicro}"/><TextBlock Text="중음" HorizontalAlignment="Center" Style="{StaticResource StudioMicro}"/><TextBlock Text="고음" HorizontalAlignment="Right" Style="{StaticResource StudioMicro}"/></Grid>
    </StackPanel></Border>
    <views:OnlineLyricsView Grid.Row="4" x:Name="OnlineLyricsPanel" Visibility="{Binding HasLyricsProvider, Converter={StaticResource PlayerVisibility}}"/>
  </Grid>
</UserControl>
