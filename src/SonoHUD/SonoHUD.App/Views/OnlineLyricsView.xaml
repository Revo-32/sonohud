<UserControl x:Class="SonoHUD.App.Views.OnlineLyricsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.AutomationId="HomeLyricsPanel">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="OptionsVisibility"/></UserControl.Resources>
  <Grid Margin="12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><Button Click="ToggleOptions" x:Name="Options" DockPanel.Dock="Right" Content="가사 옵션" Padding="10,4" AutomationProperties.Name="가사 옵션" Margin="8,0,0,0"/>      <Button DockPanel.Dock="Right" x:Name="ReturnButton" Content="현재 가사로" Click="ReturnToCurrent" Padding="12,8" Margin="0,0,8,8" Visibility="Collapsed" AutomationProperties.AutomationId="LyricsReturnCurrent"/>
    <TextBlock x:Name="Mode" DockPanel.Dock="Left" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/><TextBlock x:Name="Notice" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StudioMuted}" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="1" x:Name="ReadingPanel" BorderBrush="{DynamicResource StudioLine}" BorderThickness="0,1,0,0" Padding="4,8" Margin="0,4,0,0" Visibility="Collapsed">
      <ScrollViewer x:Name="Reader"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PreviewMouseWheel="ManualWheel" PreviewMouseDown="ManualMouse" PreviewKeyDown="ManualKey" AutomationProperties.AutomationId="LyricsScroll">
        <StackPanel x:Name="Lines" Margin="0,0,12,0" AutomationProperties.AutomationId="HomeLyricsLines"/>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource StudioPanel}" Padding="12" x:Name="OptionsPanel" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <CheckBox Content="온라인 검색" IsChecked="{Binding OnlineLyricsEnabled}" AutomationProperties.AutomationId="OnlineLyricsEnabled"/>
    <WrapPanel Margin="0,12,0,0">
      <Button x:Name="RetryButton" Content="다시 검색" Click="Retry" Padding="12,8" Margin="0,0,8,8" AutomationProperties.AutomationId="LyricsRetry"/>
      <Button x:Name="CandidatesButton" Content="다른 가사 선택" Click="FindCandidates" Padding="12,8" Margin="0,0,8,8" AutomationProperties.AutomationId="LyricsCandidates"/>

    </WrapPanel>
    <StackPanel x:Name="CandidatesPanel" Visibility="Collapsed" Margin="0,4,0,12">
      <ComboBox x:Name="Candidates" DisplayMemberPath="Label" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="LyricsCandidateList"/>
      <Button Content="이 가사 사용" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ApplyCandidate" AutomationProperties.AutomationId="LyricsApplyCandidate"/>
    </StackPanel>
    <WrapPanel x:Name="OffsetPanel" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock Text="싱크 보정" VerticalAlignment="Center" Margin="0,0,12,8"/>
      <Button Content="가사 빠르게" Click="Faster" Margin="0,0,8,8" Padding="12,8" ToolTip="가사를 0.25초 앞당깁니다"/>
      <Button Content="가사 느리게" Click="Slower" Margin="0,0,8,8" Padding="12,8" ToolTip="가사를 0.25초 늦춥니다"/>
      <Button x:Name="OffsetReset" Content="기본값" Click="ResetOffset" Margin="0,0,8,8" Padding="12,8"/>
      <TextBlock x:Name="OffsetLabel" VerticalAlignment="Center" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock TextWrapping="Wrap" Style="{DynamicResource StudioDescription}" FontSize="12" Margin="0,12,0,0"><Run Text="{Binding LyricsProviderName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LyricsProviderDisclosure, Mode=OneWay}"/></TextBlock>
</StackPanel></ScrollViewer></Border>
  </Grid>
</UserControl>
