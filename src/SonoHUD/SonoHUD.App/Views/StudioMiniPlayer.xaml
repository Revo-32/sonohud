<UserControl x:Class="SonoHUD.App.Views.StudioMiniPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SonoHUD.App.Views" AutomationProperties.AutomationId="StudioMiniPlayer" FontFamily="{x:Static views:DesignResources.FontFamily}" Foreground="{DynamicResource StudioInk}">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <Border Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioLine}" BorderThickness="0" CornerRadius="8" Padding="16,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" Background="{DynamicResource StudioBackground}" HorizontalAlignment="Left" ClipToBounds="True"><Grid>
        <views:ArtworkPlaceholder><views:ArtworkPlaceholder.Style><Style TargetType="views:ArtworkPlaceholder"><Style.Triggers><DataTrigger Binding="{Binding HasArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:ArtworkPlaceholder.Style></views:ArtworkPlaceholder>
        <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" AutomationProperties.Name="미니 플레이어 앨범아트"/>
      </Grid></Border>
      <StackPanel Grid.Column="1" Margin="8,0,24,0" VerticalAlignment="Center"><TextBlock Text="{Binding TrackTitle}" FontFamily="{x:Static views:DesignResources.FontFamily}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding TrackTitle}" AutomationProperties.AutomationId="MiniTrackTitle"/><TextBlock Text="{Binding TrackArtist}" Foreground="{DynamicResource StudioMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding TrackArtist}" Margin="0,4,0,0" AutomationProperties.AutomationId="MiniTrackArtist"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource StudioIconButton}" Background="Transparent" BorderBrush="Transparent" Width="40" Height="40" Command="{Binding PreviousCommand}" AutomationProperties.AutomationId="MiniPrevious" AutomationProperties.Name="미니 플레이어 이전 곡" ToolTip="이전 곡" Margin="0,0,8,0"><views:IconGlyph Kind="Previous" Width="18" Height="18"/></Button>
        <Button Width="44" Height="40" Padding="0" Style="{StaticResource StudioPlayback}" Command="{Binding PlayCommand}" AutomationProperties.AutomationId="MiniPlay" AutomationProperties.Name="{Binding PlayLabel}" ToolTip="{Binding PlayLabel}" Margin="0,0,8,0"><views:IconGlyph Width="18" Height="18"><views:IconGlyph.Style><Style TargetType="views:IconGlyph"><Setter Property="Kind" Value="Play"/><Style.Triggers><DataTrigger Binding="{Binding PlayGlyph}" Value="Ⅱ"><Setter Property="Kind" Value="Pause"/></DataTrigger></Style.Triggers></Style></views:IconGlyph.Style></views:IconGlyph></Button>
        <Button Style="{StaticResource StudioIconButton}" Background="Transparent" BorderBrush="Transparent" Width="40" Height="40" Command="{Binding NextCommand}" AutomationProperties.AutomationId="MiniNext" AutomationProperties.Name="미니 플레이어 다음 곡" ToolTip="다음 곡"><views:IconGlyph Kind="Next" Width="18" Height="18"/></Button>
      </StackPanel>
      <StackPanel Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Center"><Grid><TextBlock Text="{Binding CurrentTime}" Style="{StaticResource StudioTime}" FontSize="11"/><TextBlock Text="{Binding TotalTime}" Style="{StaticResource StudioTime}" FontSize="11" HorizontalAlignment="Right"/></Grid><ProgressBar Foreground="{DynamicResource StudioProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,12,0,0" AutomationProperties.AutomationId="MiniProgress" AutomationProperties.Name="미니 플레이어 재생 진행률, 읽기 전용"/></StackPanel>
    </Grid>
  </Border>
</UserControl>