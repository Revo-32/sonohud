<UserControl x:Class="SonoHUD.App.Views.TaskbarSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SonoHUD.App.Views"
             AutomationProperties.AutomationId="TaskbarSettings"
             FontFamily="{x:Static views:DesignResources.FontFamily}"
             Foreground="{DynamicResource StudioInk}"
             IsEnabled="{Binding CanCustomize}">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <Border BorderBrush="{DynamicResource StudioLine}" BorderThickness="0,0,0,1" Padding="8,22">
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="작업 표시줄 위젯" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="작업 표시줄에서 음악 확인" Style="{StaticResource StudioDescription}" Margin="0,6,20,0"/></StackPanel>
    <StackPanel Grid.Column="1">
     <CheckBox Content="작업 표시줄에 표시" IsChecked="{Binding TaskbarEnabled}" AutomationProperties.AutomationId="TaskbarEnabled"/>
     <TextBlock Text="{Binding TaskbarStatus}" Style="{StaticResource StudioDescription}" AutomationProperties.AutomationId="TaskbarStatus" Margin="0,8,0,0"/>
     <Button Content="다시 연결" Command="{Binding TaskbarRetryCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="TaskbarRetry" Margin="0,12,0,0"/>
    </StackPanel>
   </Grid>
   <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="표시할 모니터" VerticalAlignment="Center"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding TaskbarMonitors}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding TaskbarMonitorId}" AutomationProperties.AutomationId="TaskbarMonitor" AutomationProperties.Name="작업 표시줄을 표시할 모니터"/>
   </Grid>
   <Expander Header="표시 및 배치" Foreground="{DynamicResource StudioInk}" Margin="0,20,0,0" AutomationProperties.AutomationId="TaskbarOptions">
    <Grid Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="배치"/>
     <StackPanel Grid.Column="1" Margin="0,0,0,18"><ComboBox ItemsSource="{Binding TaskbarPositionChoices}" SelectedIndex="{Binding TaskbarPosition}" AutomationProperties.AutomationId="TaskbarPosition" AutomationProperties.Name="위젯 표시 위치"/><TextBlock Text="작업 표시줄의 버튼과 시계를 가리지 않는 빈 공간에 맞춥니다." Style="{StaticResource StudioDescription}" Margin="0,6,0,0"/></StackPanel>
     <TextBlock Grid.Row="1" Text="음악 정보" VerticalAlignment="Top" Margin="0,8,0,0"/>
     <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14"><CheckBox Content="앨범아트" IsChecked="{Binding TaskbarShowArtwork}" AutomationProperties.AutomationId="TaskbarArtwork" Margin="0,0,20,0"/><CheckBox Content="곡명" IsChecked="{Binding TaskbarShowTitle}" AutomationProperties.AutomationId="TaskbarTitle" Margin="0,0,20,0"/><CheckBox Content="아티스트" IsChecked="{Binding TaskbarShowArtist}" AutomationProperties.AutomationId="TaskbarArtist"/></WrapPanel>
     <TextBlock Grid.Row="2" Text="재생 버튼" VerticalAlignment="Top" Margin="0,8,0,0"/>
     <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14"><CheckBox Content="이전 · 재생/일시정지 · 다음 표시" IsChecked="{Binding TaskbarShowControls}" AutomationProperties.AutomationId="TaskbarControls"/><CheckBox Content="버튼을 왼쪽에 배치" IsChecked="{Binding TaskbarControlsLeft}" IsEnabled="{Binding TaskbarShowControls}" AutomationProperties.AutomationId="TaskbarControlsLeft"/></StackPanel>
     <TextBlock Grid.Row="3" Text="너비" VerticalAlignment="Top" Margin="0,8,0,0"/>
     <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14"><CheckBox Content="내용에 맞춰 자동 조절" IsChecked="{Binding TaskbarAutoWidth}" AutomationProperties.AutomationId="TaskbarAutoWidth"/><Grid IsEnabled="{Binding TaskbarFixedWidthEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Slider Minimum="160" Maximum="520" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding TaskbarWidth}" AutomationProperties.AutomationId="TaskbarWidth" AutomationProperties.Name="위젯 고정 너비" Margin="0,6,16,0"/><TextBlock Grid.Column="1" Text="{Binding TaskbarWidthLabel}" Style="{StaticResource StudioTime}"/></Grid></StackPanel>
     <TextBlock Grid.Row="4" Text="작은 화면 · 긴 제목" VerticalAlignment="Top" Margin="0,8,0,0"/>
     <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,14"><CheckBox Content="항상 작은 크기로 표시" IsChecked="{Binding TaskbarCompact}" AutomationProperties.AutomationId="TaskbarCompact"/><CheckBox Content="긴 곡명 자동 스크롤" IsChecked="{Binding TaskbarScrollTitle}" AutomationProperties.AutomationId="TaskbarScrollTitle"/><TextBlock Text="작은 작업 표시줄에는 자동으로 간결한 배치를 사용합니다." Style="{StaticResource StudioDescription}" Margin="0,6,0,0"/></StackPanel>
     <TextBlock Grid.Row="5" Text="스타일"/><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding TaskbarStyleChoices}" SelectedIndex="{Binding TaskbarStyle}" AutomationProperties.AutomationId="TaskbarStyle" AutomationProperties.Name="작업 표시줄 위젯 스타일"/>
    </Grid>
   </Expander>
   <TextBlock Text="음악 소스는 오디오에서 선택하며, 위젯의 오른쪽 클릭 메뉴에서도 바꿀 수 있습니다. 데스크톱 오버레이의 표시 설정에는 영향을 주지 않습니다." Style="{StaticResource StudioDescription}" Margin="0,18,0,0"/>
   <TextBlock Text="FluentFlyout 위젯과 공간이 겹치면 다른 위치를 선택하거나 FluentFlyout에서 위젯을 직접 꺼 주세요. SonoHUD가 다른 앱을 종료하거나 설정을 바꾸지는 않습니다." Style="{StaticResource StudioDescription}" Margin="0,8,0,0"/>
  </StackPanel>
 </Border>
</UserControl>
