<UserControl x:Class="SonoHUD.App.Views.DeploymentSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{DynamicResource SettingsGroup}"><StackPanel>
  <TextBlock Text="시작 및 업데이트" FontWeight="SemiBold" FontSize="18"/>
  <CheckBox x:Name="Login" Content="Windows 로그인 시 트레이에서 시작" Checked="LoginChanged" Unchecked="LoginChanged" Margin="0,10,0,0"/>
  <CheckBox x:Name="Automatic" Content="새 버전 자동 다운로드" Checked="AutoChanged" Unchecked="AutoChanged" Margin="0,6,0,0"/>
  <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,10,0,0"/>
  <WrapPanel Margin="0,8,0,0">
   <Button x:Name="Check" Content="업데이트 확인" Click="CheckClick"/>
   <Button x:Name="Download" Content="다운로드" Click="DownloadClick"/>
   <Button x:Name="Apply" Content="저장하고 재시작" Click="ApplyClick"/>
  </WrapPanel>
 </StackPanel></Border>
</UserControl>
