<UserControl x:Class="SonoHUD.App.Views.PluginSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.AutomationId="PluginSettings">
  <StackPanel>
    <TextBlock Text="확장 기능" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock x:Name="StoreNotice" TextWrapping="Wrap" Style="{DynamicResource StudioDescription}" AutomationProperties.LiveSetting="Polite"/>
    <Button x:Name="RepairButton" Content="승인 목록 복구…" Click="Repair" Visibility="Collapsed" HorizontalAlignment="Left"/>
    <TextBlock x:Name="Empty" Text="설치한 확장이 없습니다." Style="{DynamicResource StudioDescription}" Margin="0,8,0,0"/>
    <ListBox x:Name="Extensions" SelectionChanged="SelectionChanged" Margin="0,10,0,4" Padding="2"
             Background="{DynamicResource StudioPanel}" Foreground="{DynamicResource StudioInk}" BorderBrush="{DynamicResource StudioLine}"
             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="설치한 확장">
      <ListBox.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
      </DataTemplate></ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource StudioInk}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
            <Grid>
              <Border x:Name="SelectionMark" Width="3" Margin="1,4" HorizontalAlignment="Left" Background="{DynamicResource StudioFocus}" Visibility="Hidden"/>
              <ContentPresenter Margin="10,6" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StudioHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource StudioSelected}"/>
              <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StudioFocus}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
    </ListBox>
    <TextBlock x:Name="Details" TextWrapping="Wrap" Style="{DynamicResource StudioDescription}"/>
    <WrapPanel Margin="0,10,0,0">
      <Button Content="확장 설치…" Click="Install" AutomationProperties.AutomationId="InstallPlugin" Margin="0,0,6,6"/>
      <Button x:Name="EnableButton" Content="활성화…" Click="Enable" Margin="0,0,6,6"/>
      <Button x:Name="DisableButton" Content="비활성화" Click="Disable" Margin="0,0,6,6"/>
      <Button x:Name="RemoveButton" Content="제거…" Click="Remove" Margin="0,0,6,6"/>
      <Button Content="확장 폴더 열기" Click="Folder" Margin="0,0,6,6"/>
      <Button Content="새로 고침" Click="Rescan" Margin="0,0,6,6"/>
    </WrapPanel>
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" Style="{DynamicResource StudioDescription}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
