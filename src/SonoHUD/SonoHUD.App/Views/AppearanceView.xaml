<UserControl x:Class="SonoHUD.App.Views.AppearanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="8,12,8,20"><TextBlock Text="색상 테마" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><UniformGrid x:Name="Gallery" Rows="2" Columns="3"/><WrapPanel Margin="0,12,0,0"><Button x:Name="AccentButton" Content="강조색 선택" Click="AccentClick"/><Button x:Name="SpectrumButton" Content="스펙트럼 색상 선택" Click="SpectrumClick" Margin="8,0"/><CheckBox x:Name="Art" Content="앨범아트 색상 사용" VerticalAlignment="Center" Click="ArtworkClick" Margin="12,0"/><Button Content="전체 색상 기본값 복원" Click="Reset"/></WrapPanel><StackPanel x:Name="Picker" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock x:Name="PickerTitle"/><WrapPanel x:Name="Swatches" Margin="0,6,0,6"/><StackPanel Orientation="Horizontal"><TextBox x:Name="Hex" MaxLength="7" Width="100" VerticalContentAlignment="Center" AutomationProperties.Name="색상 코드"/><Button Content="적용" Margin="8,0" Click="ApplyColor"/><Button Content="테마 색 사용" Click="UseThemeColor" Margin="0,0,8,0"/><Button Content="닫기" Click="ClosePicker"/></StackPanel><TextBlock x:Name="ColorHint"/></StackPanel></StackPanel></UserControl>