<UserControl x:Class="SonoHUD.App.Views.SpectrumSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border BorderBrush="{DynamicResource StudioLine}" BorderThickness="0,0,0,1" Padding="8,22"><StackPanel>
  <CheckBox Content="음악에 반응하는 스펙트럼" IsChecked="{Binding SpectrumEnabled}" AutomationProperties.AutomationId="SpectrumEnabled"/>
  <TextBlock Text="시스템 출력의 저음·중음·고음을 함께 보여줍니다. 게임과 브라우저 소리도 포함됩니다." Style="{StaticResource StudioDescription}" Margin="0,8,0,20"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="표현" Style="{StaticResource StudioLabel}"/><ComboBox ItemsSource="{Binding SpectrumStyles}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedSpectrumStyle}" AutomationProperties.Name="스펙트럼 표현" AutomationProperties.AutomationId="SpectrumStyle"/></StackPanel>
   <StackPanel Grid.Column="2"><Grid><TextBlock Text="반응 강도" Style="{StaticResource StudioLabel}"/><TextBlock Text="{Binding SpectrumIntensity, StringFormat={}{0:0.00}×}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,24,0,8" Style="{StaticResource StudioMicro}"/></Grid><Slider Minimum="0.4" Maximum="1.6" SmallChange="0.05" LargeChange="0.2" TickFrequency="0.05" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" Value="{Binding SpectrumIntensity, Delay=250}" Margin="0" Height="40" AutomationProperties.AutomationId="SpectrumIntensity" AutomationProperties.Name="스펙트럼 반응 강도"/><Grid Margin="13,6,13,0"><TextBlock Text="약하게" Style="{StaticResource StudioMicro}"/><TextBlock Text="기본" HorizontalAlignment="Center" Style="{StaticResource StudioMicro}"/><TextBlock Text="강하게" HorizontalAlignment="Right" Style="{StaticResource StudioMicro}"/></Grid></StackPanel>
  </Grid>
  <WrapPanel Margin="0,20,0,16"><CheckBox Content="음악 화면" IsChecked="{Binding SpectrumHome}" Margin="0,0,24,0"/><CheckBox Content="데스크톱 오버레이" IsChecked="{Binding SpectrumOverlay}" Margin="0,0,24,0"/><CheckBox Content="작업 표시줄" IsChecked="{Binding SpectrumTaskbar}"/></WrapPanel>
  <TextBlock Text="색상과 움직임은 오버레이 디자인 설정을 따릅니다. ‘없음’에서도 측정값은 계속 갱신됩니다." Style="{StaticResource StudioDescription}"/>
  <TextBlock Text="{Binding SpectrumStatus}" Style="{StaticResource StudioDescription}" Margin="0,8,0,16" AutomationProperties.AutomationId="SpectrumStatus"/>
  <Expander Header="세부 조정" Foreground="{DynamicResource StudioInk}" AutomationProperties.AutomationId="SpectrumAdvanced"><StackPanel Margin="0,16,0,0">
   <TextBlock Text="분석할 출력 장치" Style="{StaticResource StudioLabel}"/><ComboBox ItemsSource="{Binding SpectrumOutputs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SpectrumDevice}" AutomationProperties.Name="스펙트럼 출력 장치"/>
   <UniformGrid Columns="2" Margin="0,16,0,0">
    <StackPanel Margin="0,0,16,16"><TextBlock Text="시작 주파수 (Hz)" Style="{StaticResource StudioLabel}"/><TextBox Text="{Binding SpectrumMinimumHz}" AutomationProperties.Name="시작 주파수"/></StackPanel>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="끝 주파수 (Hz)" Style="{StaticResource StudioLabel}"/><TextBox Text="{Binding SpectrumMaximumHz}" AutomationProperties.Name="끝 주파수"/></StackPanel>
    <StackPanel Margin="0,0,16,16"><TextBlock Text="분석 밴드 수" Style="{StaticResource StudioLabel}"/><ComboBox ItemsSource="{Binding SpectrumBandChoices}" SelectedItem="{Binding SpectrumBands}" AutomationProperties.Name="분석 밴드 수"/></StackPanel>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="프레임 상한" Style="{StaticResource StudioLabel}"/><ComboBox ItemsSource="{Binding SpectrumFrameChoices}" SelectedItem="{Binding SpectrumFrameLimit}" AutomationProperties.Name="스펙트럼 프레임 상한"/></StackPanel>
    <StackPanel Margin="0,0,16,16"><TextBlock Text="감도 (dB)" Style="{StaticResource StudioLabel}"/><TextBox Text="{Binding SpectrumSensitivity}" AutomationProperties.Name="스펙트럼 감도"/></StackPanel>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="표시 범위 (dB)" Style="{StaticResource StudioLabel}"/><TextBox Text="{Binding SpectrumRange}" AutomationProperties.Name="스펙트럼 표시 범위"/></StackPanel>
    <StackPanel Margin="0,0,16,16"><TextBlock Text="상승 반응 (ms)" Style="{StaticResource StudioLabel}"/><TextBox Text="{Binding SpectrumAttack}" AutomationProperties.Name="상승 반응 시간"/></StackPanel>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="감쇠 시간 (ms)" Style="{StaticResource StudioLabel}"/><TextBox Text="{Binding SpectrumRelease}" AutomationProperties.Name="감쇠 시간"/></StackPanel>
   </UniformGrid>
   <CheckBox Content="작은 소리의 표시 범위를 천천히 보정" IsChecked="{Binding SpectrumAutoGain}"/>
   <TextBlock Text="실제 음량은 바꾸지 않습니다. 선택한 상한과 모니터 주사율 안에서 표시하며, 모든 표시 영역은 하나의 분석 결과를 공유합니다." Style="{StaticResource StudioDescription}" Margin="0,8,0,0"/>
  </StackPanel></Expander>
 </StackPanel></Border>
</UserControl>
