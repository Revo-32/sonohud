<Window x:Class="SonoHUD.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="SonoHUD" Width="1460" Height="900" MinWidth="1100" MinHeight="720" WindowStartupLocation="Manual">
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
      <RowDefinition Height="100" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="176" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.RowSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,28,12,20">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="SonoHUD" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="YOUR SPACE. YOUR SOUND." FontSize="9" Foreground="{StaticResource Muted}" Margin="0,6,0,34" />
          <Button Content="Home" Command="{Binding NavigateCommand}" CommandParameter="Home" AutomationProperties.AutomationId="NavHome" HorizontalContentAlignment="Left" Style="{StaticResource NavHomeStyle}" AutomationProperties.Name="Home · 미디어 연결과 Scene 요약" />
          <Button Content="Scenes" Command="{Binding NavigateCommand}" CommandParameter="Scenes" AutomationProperties.AutomationId="NavScenes" Style="{StaticResource NavScenesStyle}" AutomationProperties.Name="Scenes · Scene 관리" />
          <Button Content="Editor" Command="{Binding NavigateCommand}" CommandParameter="Editor" AutomationProperties.AutomationId="NavEditor" Style="{StaticResource NavEditorStyle}" AutomationProperties.Name="Editor · 요소 편집" />
          <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" AutomationProperties.AutomationId="NavSettings" Style="{StaticResource NavSettingsStyle}" AutomationProperties.Name="Settings · 환경 설정" />
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock Text="M4.1 · 사용성 안정화" FontSize="11" Foreground="{StaticResource Muted}" />
          <TextBlock Text="Windows Composition" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="22,22,20,10">
      <ScrollViewer Visibility="{Binding HomeVisible,Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.AutomationId="HomeScroll">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">
          <TextBlock Text="음악이 머무는 나만의 공간" Style="{StaticResource Title}" />
          <TextBlock Text="위젯을 만들고, 화면에 배치하고, 원하는 모습으로 편집하세요." Foreground="{StaticResource Muted}" Margin="0,0,0,26" />
          <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="24" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="미디어 연결" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ConnectionStatus}" Margin="0,12,0,8" TextWrapping="Wrap" ToolTip="{Binding ConnectionStatus}" />
              <ComboBox ItemsSource="{Binding MediaSessions}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding SelectedMedia}" AutomationProperties.AutomationId="MediaSessions" MaxWidth="650" HorizontalAlignment="Left" MinWidth="360" AutomationProperties.Name="미디어 세션 선택" />
              <CheckBox Content="Demo Mode · 샘플 데이터로 편집" IsChecked="{Binding DemoMode}" AutomationProperties.AutomationId="DemoMode" AutomationProperties.Name="Demo Mode · 샘플 데이터로 편집" />
              <TextBlock Text="외부 가사 대신 직접 작성한 샘플 문구를 사용합니다." Foreground="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
          </Border>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="+ Music Widget" Style="{StaticResource Primary}" Command="{Binding AddSceneCommand}" AutomationProperties.AutomationId="CreateSceneHome" AutomationProperties.Name="Music Widget Scene 만들기" />
            <StackPanel>
              <TextBlock Text="내 Scene" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ActiveSceneSummary}" Foreground="{StaticResource Muted}" Margin="0,5,0,10" ToolTip="{Binding ActiveSceneSummary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,6,0,8">
            <Button Content="모두 표시 / 숨김" Command="{Binding ToggleOverlaysCommand}" AutomationProperties.AutomationId="ToggleOverlays" AutomationProperties.Name="모든 오버레이 표시 또는 숨김" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding OverlayPolicyStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
          </DockPanel>
          <ListBox ItemsSource="{Binding Scenes}" SelectedValuePath="Id" SelectedValue="{Binding SelectedSceneId}" ItemTemplate="{StaticResource SceneItem}" MaxHeight="240" AutomationProperties.AutomationId="HomeScenes" AutomationProperties.Name="Home Scene 목록" IsEnabled="{Binding SceneManagementEnabled}" />
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasScene}">
            <CheckBox Content="선택한 Scene 표시" IsChecked="{Binding SceneVisible}" AutomationProperties.AutomationId="HomeSceneVisible" AutomationProperties.Name="선택한 Scene 표시" />
            <Button Content="Canvas에서 편집" Command="{Binding NavigateCommand}" CommandParameter="Editor" AutomationProperties.AutomationId="HomeCanvasEdit" AutomationProperties.Name="Canvas에서 편집" />
            <Button Content="화면에서 편집" Command="{Binding ScreenEditCommand}" AutomationProperties.AutomationId="HomeScreenEdit" AutomationProperties.Name="화면에서 편집" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Grid Visibility="{Binding ScenesVisible,Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Scenes" Style="{StaticResource Title}" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,10,20,0">
            <WrapPanel DockPanel.Dock="Top">
              <Button Content="+ 만들기" Command="{Binding AddSceneCommand}" AutomationProperties.AutomationId="CreateScene" Style="{StaticResource Primary}" AutomationProperties.Name="Scene 만들기" />
              <Button Content="복제" Command="{Binding DuplicateSceneCommand}" AutomationProperties.AutomationId="DuplicateScene" AutomationProperties.Name="선택한 Scene 복제" />
              <Button Content="삭제" Command="{Binding DeleteSceneCommand}" AutomationProperties.AutomationId="DeleteScene" AutomationProperties.Name="선택한 Scene 삭제" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding Scenes}" SelectedValuePath="Id" SelectedValue="{Binding SelectedSceneId}" ItemTemplate="{StaticResource SceneItem}" AutomationProperties.AutomationId="ScenesList" IsEnabled="{Binding SceneManagementEnabled}" AutomationProperties.Name="Scene 목록" />
          </DockPanel>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.AutomationId="ScenePropertiesScroll" AutomationProperties.Name="Scene 속성 스크롤 영역">
            <StackPanel IsEnabled="{Binding HasScene}" MaxWidth="620" HorizontalAlignment="Stretch">
              <TextBlock Text="Scene 이름" Style="{StaticResource Caption}" />
              <TextBox Text="{Binding SceneName}" AutomationProperties.AutomationId="SceneName" AutomationProperties.Name="Scene 이름" />
              <WrapPanel>
                <CheckBox Content="활성화" IsChecked="{Binding SceneActive}" AutomationProperties.AutomationId="SceneActive" AutomationProperties.Name="Scene 활성화" />
                <CheckBox Content="화면에 표시" IsChecked="{Binding SceneVisible}" AutomationProperties.AutomationId="SceneVisible" AutomationProperties.Name="Scene 화면에 표시" />
                <CheckBox Content="클릭 통과" IsChecked="{Binding SceneClickThrough}" AutomationProperties.AutomationId="SceneClickThrough" AutomationProperties.Name="Scene 클릭 통과" />
              </WrapPanel>
              <TextBlock Text="대상 모니터" Style="{StaticResource Caption}" />
              <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Label" SelectedValuePath="Device" SelectedValue="{Binding SceneMonitor}" AutomationProperties.AutomationId="SceneMonitor" AutomationProperties.Name="Scene 대상 모니터" />
              <TextBlock Text="위치 X / Y · 모니터 기준 DIP" Style="{StaticResource Caption}" />
              <UniformGrid Columns="2">
                <TextBox Text="{Binding SceneX}" AutomationProperties.AutomationId="SceneX" AutomationProperties.Name="Scene 위치 X · 모니터 기준 DIP" ToolTip="Scene 위치 X · 모니터 기준 DIP" />
                <TextBox Text="{Binding SceneY}" AutomationProperties.AutomationId="SceneY" AutomationProperties.Name="Scene 위치 Y · 모니터 기준 DIP" ToolTip="Scene 위치 Y · 모니터 기준 DIP" />
              </UniformGrid>
              <TextBlock Text="크기 Width / Height" Style="{StaticResource Caption}" />
              <UniformGrid Columns="2">
                <TextBox Text="{Binding SceneWidth}" AutomationProperties.AutomationId="SceneWidth" AutomationProperties.Name="Scene 너비 · DIP" ToolTip="Scene 너비 · DIP" />
                <TextBox Text="{Binding SceneHeight}" AutomationProperties.AutomationId="SceneHeight" AutomationProperties.Name="Scene 높이 · DIP" ToolTip="Scene 높이 · DIP" />
              </UniformGrid>
              <TextBlock Text="애니메이션" Style="{StaticResource Caption}" />
              <ComboBox ItemsSource="{Binding Animations}" SelectedItem="{Binding SceneAnimation}" AutomationProperties.AutomationId="SceneAnimation" AutomationProperties.Name="Scene 애니메이션" />
              <WrapPanel Margin="0,20,0,0">
                <Button Content="Canvas에서 편집" Command="{Binding NavigateCommand}" CommandParameter="Editor" Style="{StaticResource Primary}" AutomationProperties.AutomationId="ScenesCanvasEdit" AutomationProperties.Name="Canvas에서 편집" />
                <Button Content="화면에서 편집" Command="{Binding ScreenEditCommand}" AutomationProperties.AutomationId="ScenesScreenEdit" AutomationProperties.Name="화면에서 편집" />
                <Button Content="저장" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="ScenesSave" AutomationProperties.Name="저장" />
              </WrapPanel>
              <TextBlock Text="클릭 통과를 끄면 위젯의 재생 버튼을 사용할 수 있습니다.&#xA;겹친 Scene은 생성 순서대로 표시됩니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid Visibility="{Binding EditorVisible,Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="↶" ToolTip="실행 취소 · Ctrl+Z" Command="{Binding UndoCommand}" AutomationProperties.AutomationId="Undo" AutomationProperties.Name="실행 취소" />
            <Button Content="↷" ToolTip="다시 실행 · Ctrl+Y" Command="{Binding RedoCommand}" AutomationProperties.AutomationId="Redo" AutomationProperties.Name="다시 실행" />
            <Button Content="저장" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="Save" AutomationProperties.Name="Scene 저장" ToolTip="저장 · Ctrl+S" />
            <Button Content="화면에서 편집" Command="{Binding ScreenEditCommand}" AutomationProperties.AutomationId="ScreenEdit" Style="{StaticResource Primary}" AutomationProperties.Name="화면에서 Scene 편집" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding Scenes}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding SelectedSceneId}" Width="230" HorizontalAlignment="Left" IsEnabled="{Binding SceneManagementEnabled}" AutomationProperties.AutomationId="EditorScenes" AutomationProperties.Name="편집할 Scene 선택" />
        </DockPanel>
        <WrapPanel Grid.Row="1" IsEnabled="{Binding HasScene}">
          <ComboBox ItemsSource="{Binding ElementKinds}" SelectedItem="{Binding AddKind}" Width="146" AutomationProperties.AutomationId="ElementKind" AutomationProperties.Name="추가할 요소 종류" />
          <Button Content="+ 요소" Command="{Binding AddElementCommand}" AutomationProperties.AutomationId="AddElement" AutomationProperties.Name="요소 추가" />
          <Button Content="복제" Command="{Binding DuplicateElementCommand}" AutomationProperties.AutomationId="DuplicateElement" AutomationProperties.Name="선택한 요소 복제" ToolTip="선택한 요소를 복제합니다." />
          <Button Content="삭제" Command="{Binding DeleteElementCommand}" AutomationProperties.AutomationId="DeleteElement" AutomationProperties.Name="선택한 요소 삭제" />
          <Button Content="그룹" Command="{Binding GroupCommand}" AutomationProperties.AutomationId="Group" AutomationProperties.Name="선택한 요소 그룹화" />
          <Button Content="해제" Command="{Binding UngroupCommand}" AutomationProperties.AutomationId="Ungroup" AutomationProperties.Name="선택한 그룹 해제" />
          <Button Content="앞으로" Command="{Binding LayerUpCommand}" AutomationProperties.AutomationId="LayerUp" AutomationProperties.Name="선택한 요소 앞으로" />
          <Button Content="뒤로" Command="{Binding LayerDownCommand}" AutomationProperties.AutomationId="LayerDown" AutomationProperties.Name="선택한 요소 뒤로" />
          <CheckBox Content="8 DIP 스냅" IsChecked="{Binding GridSnap}" IsEnabled="{Binding SceneManagementEnabled}" AutomationProperties.AutomationId="GridSnap" AutomationProperties.Name="8 DIP 격자에 맞추기" />
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="236" />
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource Panel}" CornerRadius="6" Margin="0,0,10,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="레이어 · Ctrl로 다중 선택" Foreground="{StaticResource Muted}" Margin="12,12,0,8" FontSize="11" />
              <ListBox x:Name="LayerList" ItemsSource="{Binding Layers}" SelectionMode="Extended" SelectionChanged="LayersSelected" AutomationProperties.AutomationId="Layers" AutomationProperties.Name="레이어 목록 · Ctrl로 다중 선택">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="CanvasHost" AutomationProperties.AutomationId="CanvasHost" AutomationProperties.Name="Scene 편집 Canvas" />
            <TextBlock Grid.Row="1" Text="드래그로 이동 · 오른쪽 아래 핸들로 크기 변경" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
          </Grid>
          <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="6" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.AutomationId="ElementPropertiesScroll" AutomationProperties.Name="요소 속성 스크롤 영역">
              <StackPanel Margin="14">
                <TextBlock Text="{Binding ElementTypeLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel IsEnabled="{Binding HasElement}">
                  <TextBlock Text="요소 이름" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding ElementName}" AutomationProperties.AutomationId="ElementName" AutomationProperties.Name="요소 이름" />
                  <WrapPanel>
                    <CheckBox Content="표시" IsChecked="{Binding ElementVisible}" AutomationProperties.AutomationId="ElementVisible" AutomationProperties.Name="요소 표시" />
                    <CheckBox Content="잠금" IsChecked="{Binding ElementLocked}" AutomationProperties.AutomationId="ElementLocked" AutomationProperties.Name="요소 잠금" />
                  </WrapPanel>
                  <TextBlock Text="위치 X / Y" Style="{StaticResource Caption}" />
                  <UniformGrid Columns="2">
                    <TextBox Text="{Binding ElementX}" AutomationProperties.AutomationId="ElementX" AutomationProperties.Name="요소 위치 X" ToolTip="요소 위치 X" />
                    <TextBox Text="{Binding ElementY}" AutomationProperties.AutomationId="ElementY" AutomationProperties.Name="요소 위치 Y" ToolTip="요소 위치 Y" />
                  </UniformGrid>
                  <TextBlock Text="크기 W / H" Style="{StaticResource Caption}" />
                  <UniformGrid Columns="2">
                    <TextBox Text="{Binding ElementWidth}" AutomationProperties.AutomationId="ElementWidth" AutomationProperties.Name="요소 너비" ToolTip="요소 너비" />
                    <TextBox Text="{Binding ElementHeight}" AutomationProperties.AutomationId="ElementHeight" AutomationProperties.Name="요소 높이" ToolTip="요소 높이" />
                  </UniformGrid>
                  <TextBlock Text="회전 ° / 배율" Style="{StaticResource Caption}" />
                  <UniformGrid Columns="2">
                    <TextBox Text="{Binding ElementRotation}" AutomationProperties.AutomationId="ElementRotation" AutomationProperties.Name="요소 회전 · 도" ToolTip="요소 회전 · 도" />
                    <TextBox Text="{Binding ElementScale}" AutomationProperties.AutomationId="ElementScale" AutomationProperties.Name="요소 배율" ToolTip="요소 배율" />
                  </UniformGrid>
                  <TextBlock Text="불투명도 %" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding ElementOpacity}" AutomationProperties.AutomationId="Opacity" AutomationProperties.Name="요소 불투명도 · 퍼센트" ToolTip="요소 불투명도 · 퍼센트" />
                  <TextBlock Text="텍스트 / 샘플 가사" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding ElementText}" TextWrapping="Wrap" MinHeight="50" AutomationProperties.AutomationId="ElementText" AutomationProperties.Name="텍스트 또는 샘플 가사" AcceptsReturn="True" MaxHeight="130" VerticalScrollBarVisibility="Auto" />
                  <TextBlock Text="글꼴 이름" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding FontFamily}" AutomationProperties.AutomationId="FontFamily" AutomationProperties.Name="글꼴 이름" />
                  <TextBlock Text="글꼴 크기" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding FontSize}" AutomationProperties.AutomationId="FontSize" AutomationProperties.Name="글꼴 크기" />
                  <TextBlock Text="글꼴 굵기 · 100~900" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding FontWeight}" AutomationProperties.AutomationId="FontWeight" AutomationProperties.Name="글꼴 굵기 · 100부터 900" ToolTip="글꼴 굵기: 100~900, 보통 400, 굵게 700" />
                  <TextBlock Text="전경 색상 · #AARRGGBB" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding ForegroundColor}" AutomationProperties.AutomationId="ForegroundColor" AutomationProperties.Name="전경 색상" ToolTip="전경 색상: #RRGGBB 또는 #AARRGGBB" />
                  <TextBlock Text="배경 색상 · #AARRGGBB" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding BackgroundColor}" AutomationProperties.AutomationId="BackgroundColor" AutomationProperties.Name="배경 색상" ToolTip="배경 색상: #RRGGBB 또는 #AARRGGBB" />
                  <Button Content="이미지 가져오기…" Command="{Binding ImportImageCommand}" AutomationProperties.AutomationId="ImportImage" AutomationProperties.Name="요소 이미지 가져오기" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
      <ScrollViewer Visibility="{Binding SettingsVisible,Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.AutomationId="SettingsScroll">
        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" IsEnabled="{Binding SceneManagementEnabled}">
          <TextBlock Text="Settings" Style="{StaticResource Title}" />
          <TextBlock Text="표시와 입력" FontSize="18" Margin="0,15,0,6" />
          <CheckBox Content="시작 시 저장된 Scene 표시" IsChecked="{Binding ShowOnStartup}" AutomationProperties.AutomationId="ShowOnStartup" AutomationProperties.Name="시작 시 저장된 Scene 표시" />
          <CheckBox Content="새 Scene에서 클릭 통과 사용" IsChecked="{Binding DefaultClickThrough}" AutomationProperties.AutomationId="DefaultClickThrough" AutomationProperties.Name="새 Scene에서 클릭 통과 사용" />
          <CheckBox Content="전역 단축키로 모든 오버레이 표시 / 숨김" IsChecked="{Binding HotkeyEnabled}" AutomationProperties.AutomationId="HotkeyEnabled" AutomationProperties.Name="전역 단축키로 모든 오버레이 표시 / 숨김" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Ctrl + Alt + F" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding HotkeyKeys}" SelectedItem="{Binding HotkeyFunction}" Width="85" AutomationProperties.AutomationId="HotkeyFunction" AutomationProperties.Name="전역 단축키의 F 키 번호" />
          </StackPanel>
          <TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
          <TextBlock Text="새 Scene의 기본 모니터" Style="{StaticResource Caption}" />
          <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Label" SelectedValuePath="Device" SelectedValue="{Binding DefaultMonitor}" AutomationProperties.AutomationId="DefaultMonitor" AutomationProperties.Name="새 Scene의 기본 모니터" />
          <Button Content="모니터 새로고침" Command="{Binding RefreshMonitorsCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RefreshMonitors" AutomationProperties.Name="연결된 모니터 새로고침" />
          <TextBlock Text="기본 애니메이션" Style="{StaticResource Caption}" />
          <ComboBox ItemsSource="{Binding Animations}" SelectedItem="{Binding DefaultAnimation}" Width="180" HorizontalAlignment="Left" AutomationProperties.AutomationId="DefaultAnimation" AutomationProperties.Name="새 Scene의 기본 애니메이션" />
          <TextBlock Text="데이터 저장 위치" Style="{StaticResource Caption}" />
          <TextBox Text="{Binding DataPath,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.AutomationId="DataPath" AutomationProperties.Name="데이터 저장 위치" HorizontalScrollBarVisibility="Disabled" />
          <TextBlock Text="변경 사항은 자동 저장됩니다. 화면 편집 중에는 저장 / 취소를 먼저 선택하세요." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock Text="M4에서는 시스템 오디오·외부 가사 동기화·설치 프로그램을 제공하지 않습니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,20,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status}" Margin="22,0,12,0" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.AutomationId="Status" AutomationProperties.Name="작업 상태" />
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1D2631" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="22,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Border Width="58" Height="58" CornerRadius="8" Background="#2A4C43">
          <Grid>
            <TextBlock Text="♫" FontSize="27" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
            <Image Source="{Binding AlbumArt}" Stretch="UniformToFill" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding TrackTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding TrackTitle}" />
          <TextBlock Text="{Binding TrackArtist}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding TrackArtist}" />
          <TextBlock Text="{Binding MediaStatus}" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MediaStatus}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="이전" Command="{Binding PreviousCommand}" AutomationProperties.AutomationId="Previous" AutomationProperties.Name="이전 곡" />
          <Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" AutomationProperties.AutomationId="Play" AutomationProperties.Name="{Binding PlayLabel}" />
          <Button Content="다음" Command="{Binding NextCommand}" AutomationProperties.AutomationId="Next" AutomationProperties.Name="다음 곡" />
        </StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center">
          <ProgressBar Value="{Binding Progress,Mode=OneWay}" Maximum="100" Height="4" Background="#344355" Foreground="{StaticResource Accent}" BorderThickness="0" />
          <TextBlock Text="{Binding PositionText}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,10,0,0" ToolTip="{Binding PositionText}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ConnectionStatus}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding ConnectionStatus}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
